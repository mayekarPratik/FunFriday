{
  "name": "funfriday-backend",
  "version": "1.0.0",
  "description": "Social Deduction Engine Game Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:ts-node-dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:e2e": "ts-node-dev test-client.ts"
  },
  "keywords": [
    "socket.io",
    "express",
    "redis",
    "typescript",
    "multiplayer-game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "funfriday-root": "file:..",
    "ioredis": "^5.4.2",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
